# Server-only configuration. Keep real values in private hosting settings.
# Neon injects DATABASE_URL for deployed functions.
DATABASE_URL=
API_SESSION_KEY=
API_OTP_KEY=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ALLOWED_ORIGINS=https://rk-hud.github.io
PUBLIC_WEB_URL=https://rk-hud.github.io/cyber-suraksha-2.0/
NODE_ENV=production

# Enable only after real authorized sender delivery has been verified.
REGISTRATION_ENABLED=0
EMAIL_READY=0
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=

# Alternative authenticated TLS-only SMTP transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Google Identity Services — independent citizen sign-in, no Resend required.
# Configure ONLY after creating a real Web OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_SIGNIN_ENABLED=0
GOOGLE_REGISTRATION_ENABLED=0
# Optional private exact-address allowlist for approved staging testers.
# Empty means no additional server-side allowlist; Google's own settings apply.
GOOGLE_ALLOWED_EMAILS=
