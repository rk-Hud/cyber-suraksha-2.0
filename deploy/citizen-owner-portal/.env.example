# Configure real values privately in Render. This file contains no credentials.
# The application does not automatically load this file.
ADMIN_EMAIL=ramakrishnajatoth2007@gmail.com
PRIVATE_MODE=0
PUBLIC_REGISTRATION=1
FORCE_HTTPS=1
ALLOW_SQLITE=0
LOGIN_RETENTION_DAYS=30

# Three different, cryptographically random strings, each at least 32 characters.
# Keep backups in a password manager, never in chat or a project document.
SECRET_KEY=
OTP_HMAC_KEY=
TOTP_ENCRYPTION_KEY=

# Persistent PostgreSQL connection string. Use Render's internal connection URL.
DATABASE_URL=

# Leave PUBLIC_BASE_URL unset on direct Render hosting to use RENDER_EXTERNAL_URL.
# Otherwise set the exact HTTPS origin, with no path or trailing slash.
# PUBLIC_BASE_URL=https://your-owned-domain.example
# PUBLIC_HOSTS=your-owned-domain.example
# Exact number of trusted reverse proxies; Render configuration uses one.
TRUSTED_PROXY_HOPS=1

# Email is NOT configured in the delivered environment.
# Select one actual provider after verifying its sender/domain and credentials.
# Use a NEW password for the website; this is never a Gmail-password collection form.
MAIL_PROVIDER=
MAIL_FROM=

# Resend: HTTPS delivery is suitable for Render free web-service testing.
RESEND_API_KEY=

# Authenticated SMTP with verified TLS; use a plan/network permitting SMTP ports.
# Render free web services block outbound ports 25, 465 and 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Optional Google Safe Browsing V5 evidence; local checker works without this.
# Review docs/REPUTATION.md and provider terms before activating.
SAFEBROWSING_API_KEY=

# Clear Render's injected Gunicorn flags; use the checked-in start configuration.
GUNICORN_CMD_ARGS=
